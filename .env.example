# =============================================================================
# CLAIRE Studio — variables d'environnement (exemple)
# Copier en `.env` et renseigner. NE PAS committer `.env`.
# Placeholders uniquement ici — aucun secret réel.
# =============================================================================

# --- Général -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=claire-studio
ENVIRONMENT=development

# --- PostgreSQL (service `postgres`) -----------------------------------------
POSTGRES_DB=claire
POSTGRES_USER=claire
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# URL consommée par Django (DSN). En local hors docker: postgresql://...@localhost:5432/claire
DATABASE_URL=postgresql://claire:change-me-postgres-password@postgres:5432/claire
# Base dédiée aux tests (CI / e2e). Optionnel : sinon DATABASE_URL avec suffixe _test.
TEST_DATABASE_URL=postgresql://claire:change-me-postgres-password@postgres:5432/claire_test

# --- Django / DRF (service `backend`) ----------------------------------------
DJANGO_SECRET_KEY=change-me-django-secret-key-50-chars-minimum
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_LOG_LEVEL=INFO

# CORS / CSRF — autoriser le frontend Next.js
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Authentification JWT ----------------------------------------------------
JWT_SIGNING_KEY=change-me-jwt-signing-key
JWT_ACCESS_TOKEN_LIFETIME_MIN=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Seed (comptes de démonstration) -----------------------------------------
SEED_DEFAULT_PASSWORD=change-me-seed-password
SEED_ADMIN_EMAIL=admin@example.com

# --- Pré-annotations LLM (F2) — pull optionnel -------------------------------
# Laisser vide pour import par upload uniquement (aucun appel réseau en test).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PREANNOTATION_PULL_ENABLED=0

# --- Chemins file-based (F8 translations, F2 imports) ------------------------
# Racine confinée pour les dossiers de traduction (Q-SEC-03 path-safety).
TRANSLATIONS_ROOT=/data/translations
IMPORTS_ROOT=/data/imports

# --- Exports (F5) ------------------------------------------------------------
EXPORTS_ARTIFACT_DIR=/data/exports
EXPORTS_MAX_CONCURRENCY_PER_PROJECT=2

# --- Frontend (Next.js, service `frontend`) ----------------------------------
# DOIT pointer vers l'API versionnée. En docker: http://backend:8000/api/v1 (build/SSR)
# ; en navigateur: http://localhost:8000/api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=CLAIRE Studio
NEXT_TELEMETRY_DISABLED=1

# --- Ports exposés (hôte) ----------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
ADMINER_PORT=8080

# --- E2E / Playwright --------------------------------------------------------
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:8000/api/v1
