data/raw/*
!data/raw/README.md
graph/export/*/
results/*/
*.pyc
__pycache__/
.pytest_cache/
# Export du dataset : les textes (CLAUDETTE, licence tierce) et les gros fichiers ne sont pas versionnés ici.
# Les couches d'annotation publiées vivent dans ../data/thematic-layer/ (versionnées) ; voir data/processed/README.md
data/processed/*.jsonl
data/annotations/clauses_all.jsonl
data/annotations/holdout/clauses.jsonl
.venv/
results/extraction/dry-run/
# Baselines : on versionne le README et les petits fichiers de synthèse (run.json), pas les gros artefacts
!results/baselines/
results/baselines/*/*
!results/baselines/*/run.json
!results/baselines/*/SUPERSEDED.md
!results/baselines/README.md
!results/baselines/*/results.json
!results/baselines/*/ANALYSIS.md
!results/baselines/*/ANALYSIS.json
!results/baselines/*/predictions.jsonl
# Extraction et règles : synthèses sans texte de contrat versionnées (les lots et step_*.jsonl contiennent des textes CLAUDETTE)
!results/extraction/
results/extraction/*/*
!results/extraction/*/run.json
!results/extraction/*/STABILITY.json
!results/extraction/*/MANIFEST.json
!results/extraction/*/USAGE.json
!results/extraction/*/CODEX_CALLS.jsonl
!results/rules/
results/rules/*/*
!results/rules/*/SUMMARY.json
!results/parity/
results/parity/*/*
!results/parity/*/PARITY.md
!results/parity/*/PARITY.json
