[Unit]
Description=CLAIRE Studio - Pactiva Analysis Lab worker
After=network.target postgresql.service claire-studio.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/claire-studio/backend
EnvironmentFile=/var/www/claire-studio/backend/.env
ExecStart=/var/www/claire-studio/backend/.venv/bin/python manage.py analysis_worker --poll 1
Restart=always
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
