# CLAIRE Studio backend — environment template. Copy to .env (never commit .env).
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# SQLite dev (default). For Postgres:
# DATABASE_URL=postgres://user:pass@localhost:5432/claire

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Paths to real corpora / pre-annotations (defaults resolve to the CLAIRE repo).
# CLAIRE_CLAUDETTE_DIR=/abs/path/to/data/raw/claudette_tos
# CLAIRE_ANNOTATIONS_DIR=/abs/path/to/annotations

# Seeders (dé-rigidification) — aucune valeur métier en dur. Défauts = démo CLAUDETTE ;
# surchargez pour brancher un tout autre corpus/projet, ou un mot de passe non public.
# CLAIRE_SEED_PASSWORD=claire-demo
# CLAIRE_SEED_CORPUS_SLUG=claudette-tos
# CLAIRE_SEED_PROJECT_SLUG=claudette-gold-v1
# CLAIRE_SEED_TRANSLATION_FOLDER=claudette_fr
# Annotation humaine VIDE par défaut (LLM = suggestions). True restaure le seed
# d'annotations humaines depuis le LLM (démo/IAA peuplée).
# CLAIRE_SEED_HUMAN_FROM_LLM=false

# E-mail — Stalwart SMTP en prod. Dev = console (aucun SMTP requis).
# Aucun secret en dur : renseignez ces variables en prod (cf. .credentials/).
# Backend custom : TLS chiffré SANS vérif de chaîne, car le Stalwart local ne
# présente que le cert feuille sur 587 (saut local de confiance, cf. claire/common/email_backends.py).
# DJANGO_EMAIL_BACKEND=claire.common.email_backends.LocalTrustedTLSBackend
# EMAIL_HOST=mail.lumiereacademy.com          # FQDN = match du cert (résout sur la même machine)
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=no-reply@pactiva.legal
# EMAIL_HOST_PASSWORD=change-me                # mot de passe Stalwart de no-reply@ (cf. .credentials/)
# DEFAULT_FROM_EMAIL=Pactiva <no-reply@pactiva.legal>
# SERVER_EMAIL=no-reply@pactiva.legal
# FRONTEND_BASE_URL=https://pactiva.legal
# EMAIL_TOKEN_MAX_AGE=86400

# Frontend (build Next) — adresse de contact publique affichée sur la home.
# NEXT_PUBLIC_CONTACT_EMAIL=info@pactiva.legal
