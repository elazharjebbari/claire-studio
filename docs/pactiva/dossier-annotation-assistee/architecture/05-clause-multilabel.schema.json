{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pactiva.legal/schemas/clause-multilabel.json",
  "title": "Clause multi-label validée (oracle)",
  "type": "object",
  "required": ["doc", "clauseId", "span", "boundary", "themes"],
  "additionalProperties": false,
  "properties": {
    "doc": { "type": "string" },
    "clauseId": { "type": "integer", "minimum": 0 },
    "span": {
      "type": "object",
      "required": ["startId", "endId"],
      "additionalProperties": false,
      "properties": {
        "startId": { "type": "integer", "minimum": 0 },
        "endId": { "type": "integer", "minimum": 0 }
      }
    },
    "boundary": {
      "type": "object",
      "required": ["type", "support"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["hard", "soft"] },
        "support": { "type": "integer", "minimum": 1 },
        "trigger": { "type": "string" },
        "validatedBy": { "type": ["string", "null"] }
      }
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "role"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "role": { "enum": ["primary", "secondary"] },
          "support": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "triageLevel": { "enum": ["C1", "C2", "C3", "C4", "C5"] },
    "certainty": { "type": "integer", "minimum": 0, "maximum": 3,
      "description": "Certitude subjective humaine (0..3) — ORTHOGONALE au triageLevel" },
    "provenance": {
      "type": "object",
      "properties": {
        "judges": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "audit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event"],
        "properties": {
          "event": { "type": "string", "examples": ["auto_primary", "auto_override", "human_validate", "merge", "split"] },
          "rule": { "type": "string" },
          "by": { "type": "string" },
          "ts": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "$comment": "INVARIANTS (validés applicativement, non exprimables purement en JSON Schema) : (1) exactement un theme role=primary ; (2) aucun theme refuge (PREAMBLE_SCOPE|MISC_BOILERPLATE) avec role=secondary ; (3) span.endId >= span.startId ; (4) clauses contiguës et couvrantes au niveau document."
}
