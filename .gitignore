.env
.env.local
backend/.env
frontend/.env.local

# OS / IDE
.DS_Store
.idea/
.vscode/
*.log
/docs.zip

# Exports générés (artefacts backend uniquement — PAS le source front admin/exports).
backend/exports/
backend/var/

# Données volumineuses (corpus + pré-annotations) — locales, non versionnées.
# Le seeder les lit depuis data/ ; un échantillon de traductions reste suivi.
/data/claudette_tos/
/data/preannotations/
!/data/translations/
!/data/translations/**

# Artefacts du Lab (datasets et résultats de runs) — volumineux et reproductibles
# depuis la base : on versionne le CODE qui les produit, jamais les sorties.
var/lab/
research/.cache/
research/**/__pycache__/
