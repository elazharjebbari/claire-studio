# Frontend env — copier en `.env.local`.
#
# MODE DONNÉES RÉELLES (par défaut ci-dessous) : le frontend parle à l'API Django.
#   - NEXT_PUBLIC_ENABLE_MOCKS=false  → pas de MSW, vraies requêtes réseau (JWT requis)
#   - NEXT_PUBLIC_API_BASE            → URL de base de l'API backend
NEXT_PUBLIC_ENABLE_MOCKS=false
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# AUTO-LOGIN DEV (mode réel uniquement) : connecte l'app au démarrage avec ces
# identifiants si aucun token n'est présent. Désactiver (=false) pour exiger le
# passage par /login. Ignoré en mode mock.
NEXT_PUBLIC_AUTO_LOGIN=true
NEXT_PUBLIC_AUTO_LOGIN_USER=alice
NEXT_PUBLIC_AUTO_LOGIN_PASSWORD=claire-demo

# DEBUG : la DebugBar s'affiche en mode réel ; forcer son affichage en mock avec :
# NEXT_PUBLIC_DEBUG=true

# MODE DÉMO / MOCK (sans backend) : décommenter pour une UI autonome (MSW).
# En mode mock, toute la logique d'auth (auto-login, garde, redirection) est
# DÉSACTIVÉE pour préserver les tests E2E Playwright.
# NEXT_PUBLIC_ENABLE_MOCKS=true
