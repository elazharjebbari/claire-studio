# =============================================================================
# CLAIRE Studio — PORTS PRÉDÉFINIS (source unique de vérité)
# Sourcé par scripts/dev_all.sh, scripts/stop_all.sh et docker-compose.
# Surcharge possible via variables d'environnement (export BACKEND_PORT=... etc.).
# =============================================================================

# API REST Django (DRF)
BACKEND_PORT=8000
# Temps réel : ASGI / Django Channels (WebSocket)  — point 4b/7
ASGI_PORT=8001
# Frontend Next.js
FRONTEND_PORT=3000
# Redis (channel layer pour Channels + présence/verrous)
REDIS_PORT=6379
# Postgres (mode docker / prod ; en dev local SQLite, non utilisé)
POSTGRES_PORT=5432
# Adminer (profil docker `tools`)
ADMINER_PORT=8080
